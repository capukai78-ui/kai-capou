<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Botly — Panel Completo</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root{
  --g:#00D97E;--g2:#00B865;--g3:rgba(0,217,126,.1);--g4:rgba(0,217,126,.05);
  --bg:#050905;--bg2:#0c110d;--bg3:#111810;--bg4:#161e17;
  --border:rgba(0,217,126,.07);--border2:rgba(0,217,126,.2);
  --text:#eef2ee;--text2:rgba(238,242,238,.45);--text3:rgba(238,242,238,.22);
  --red:#FF4B4B;--amber:#F5A623;--blue:#4B9EFF;--purple:#A855F7;
  --font-h:'Syne',sans-serif;--font:'DM Sans',sans-serif;--r:14px;--r2:10px;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-font-smoothing:antialiased}
body{font-family:var(--font);background:var(--bg);color:var(--text);min-height:100vh}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:linear-gradient(rgba(0,217,126,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(0,217,126,.02) 1px,transparent 1px);background-size:56px 56px;}
.app{display:flex;min-height:100vh;position:relative;z-index:1}
.sb{width:228px;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;position:fixed;height:100vh;z-index:50;overflow-y:auto}
.main{margin-left:228px;flex:1;padding:26px 30px}
/* SIDEBAR */
.logo{padding:22px 20px 6px;font-family:var(--font-h);font-size:24px;font-weight:800;color:var(--g);letter-spacing:-1.5px;display:flex;align-items:center;gap:7px}
.logo-pulse{width:7px;height:7px;border-radius:50%;background:var(--g);animation:gp 2.5s ease infinite;flex-shrink:0}
@keyframes gp{0%,100%{box-shadow:0 0 0 0 rgba(0,217,126,.5)}60%{box-shadow:0 0 0 8px rgba(0,217,126,0)}}
.plan-tag{margin:8px 16px 14px;background:var(--g3);border:1px solid var(--border2);border-radius:6px;padding:4px 12px;font-size:11px;font-weight:600;color:var(--g);text-transform:uppercase;letter-spacing:.08em;display:inline-flex;align-items:center;gap:5px}
.plan-tag::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--g);animation:gp 2s ease infinite}
.role-badge{display:inline-block;padding:2px 10px;border-radius:4px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin:0 16px 14px}
.ra{background:rgba(168,85,247,.15);color:#A855F7}
.rv{background:rgba(75,158,255,.15);color:#4B9EFF}
.rg{background:rgba(245,166,35,.15);color:#F5A623}
.ns{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.12em;padding:0 20px 5px;margin-top:4px}
.nl{display:flex;align-items:center;gap:10px;padding:9px 20px;font-size:13px;color:var(--text2);cursor:pointer;transition:all .15s;border-left:2px solid transparent;text-decoration:none}
.nl:hover{color:var(--text);background:var(--g4)}
.nl.active{color:var(--g);background:var(--g3);border-left-color:var(--g);font-weight:500}
.nl svg{width:15px;height:15px;opacity:.7;flex-shrink:0}
.nl.active svg{opacity:1}
.sb-bot{margin-top:auto;padding:14px 16px;border-top:1px solid var(--border)}
.uc{display:flex;align-items:center;gap:10px;padding:10px;border-radius:var(--r2);background:var(--bg3);border:1px solid var(--border)}
.uav{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--g),var(--g2));display:flex;align-items:center;justify-content:center;font-family:var(--font-h);font-size:14px;font-weight:700;color:#000;flex-shrink:0}
.un{font-size:13px;font-weight:500}.ue{font-size:10px;color:var(--text2);margin-top:1px}
.logout-btn{font-size:11px;color:var(--text3);cursor:pointer;background:none;border:none;margin-top:8px;padding:4px 10px;display:flex;align-items:center;gap:4px;transition:color .15s;font-family:var(--font)}
.logout-btn:hover{color:var(--red)}
/* LAYOUT HELPERS */
.ph{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px;gap:12px;flex-wrap:wrap}
.ph-title{font-family:var(--font-h);font-size:22px;font-weight:800;letter-spacing:-.8px}
.ph-sub{font-size:13px;color:var(--text2);margin-top:4px}
.live-pill{display:inline-flex;align-items:center;gap:7px;background:var(--g3);border:1px solid var(--border2);border-radius:100px;padding:7px 16px;font-size:12px;font-weight:600;color:var(--g)}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--g);animation:gp 2s ease infinite}
.rpill{background:var(--bg3);border:1px solid var(--border);border-radius:100px;padding:7px 14px;font-size:11px;color:var(--text2);cursor:pointer;transition:all .15s;font-family:var(--font);border:none}
.rpill:hover{color:var(--g)}
/* METRICS */
.mrow{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.mrow3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.mc{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:18px 20px;position:relative;overflow:hidden;transition:border-color .2s,transform .2s}
.mc:hover{border-color:var(--border2);transform:translateY(-2px)}
.mc::after{content:'';position:absolute;top:0;left:0;right:0;height:1.5px;background:var(--ac,var(--g))}
.mc.amber{--ac:var(--amber)}.mc.blue{--ac:var(--blue)}.mc.purple{--ac:var(--purple)}
.mc-lbl{font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.07em;font-weight:500;margin-bottom:8px}
.mc-val{font-family:var(--font-h);font-size:26px;font-weight:800;letter-spacing:-1px;color:var(--ac,var(--g));line-height:1;margin-bottom:4px}
.mc-sub{font-size:11px;color:var(--text3)}
/* TABLE */
.tw{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;margin-bottom:16px}
.tw-h{padding:14px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);gap:10px;flex-wrap:wrap}
.tw-t{font-family:var(--font-h);font-size:13px;font-weight:700;letter-spacing:-.2px}
table{width:100%;border-collapse:collapse}
th{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;padding:9px 20px;text-align:left;border-bottom:1px solid var(--border)}
td{padding:11px 20px;font-size:13px;border-bottom:1px solid rgba(0,217,126,.04)}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--g4)}
.bx{display:inline-flex;align-items:center;padding:3px 10px;border-radius:100px;font-size:10px;font-weight:700;text-transform:uppercase}
.bx.ok{background:rgba(0,217,126,.12);color:var(--g)}
.bx.warn{background:rgba(245,166,35,.12);color:var(--amber)}
.bx.blue{background:rgba(75,158,255,.12);color:var(--blue)}
.bx.purple{background:rgba(168,85,247,.12);color:var(--purple)}
.bx.red{background:rgba(255,75,75,.12);color:var(--red)}
/* FORM */
.fc{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:20px;margin-bottom:16px}
.ft{font-family:var(--font-h);font-size:14px;font-weight:700;margin-bottom:16px;letter-spacing:-.3px}
.fg{margin-bottom:12px}
.fl{font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.07em;font-weight:600;margin-bottom:6px;display:block}
.fi{width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:10px 13px;font-size:13px;color:var(--text);outline:none;font-family:var(--font);transition:border-color .2s}
.fi:focus{border-color:var(--border2)}
.fs{width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:10px 13px;font-size:13px;color:var(--text);outline:none;font-family:var(--font)}
.fta{width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:10px 13px;font-size:13px;color:var(--text);outline:none;font-family:var(--font);resize:vertical;min-height:110px;transition:border-color .2s}
.fta:focus{border-color:var(--border2)}
.btn-p{background:linear-gradient(135deg,var(--g2),var(--g));color:#000;font-weight:700;font-size:13px;border:none;border-radius:8px;padding:10px 20px;cursor:pointer;font-family:var(--font-h);letter-spacing:.02em;transition:opacity .2s}
.btn-p:hover{opacity:.88}
.btn-g{background:var(--bg3);color:var(--text2);border:1px solid var(--border);font-size:13px;border-radius:8px;padding:10px 18px;cursor:pointer;font-family:var(--font);transition:all .15s}
.btn-g:hover{color:var(--text);border-color:var(--border2)}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
/* KAI ANIMADO */
.kai-stage{position:relative;width:100%;height:320px;overflow:hidden;border-radius:var(--r);background:linear-gradient(135deg,#030a04,#071208);border:1px solid var(--border2);margin-bottom:20px;display:flex;align-items:center;justify-content:center}
.kai-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(0,217,126,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(0,217,126,.04) 1px,transparent 1px);background-size:40px 40px}
.kai-glow{position:absolute;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(0,217,126,.15) 0%,transparent 70%);animation:glow-p 4s ease infinite}
@keyframes glow-p{0%,100%{transform:scale(1);opacity:.6}50%{transform:scale(1.2);opacity:1}}
.kai-float{position:relative;z-index:2;animation:kf 3s ease-in-out infinite}
@keyframes kf{0%,100%{transform:translateY(0) rotate(0deg)}25%{transform:translateY(-12px) rotate(1deg)}75%{transform:translateY(-6px) rotate(-1deg)}}
.kai-img{width:200px;height:200px;object-fit:cover;object-position:top center;border-radius:50%;border:3px solid rgba(0,217,126,.4);box-shadow:0 0 40px rgba(0,217,126,.3)}
.kai-ring{position:absolute;inset:-12px;border-radius:50%;border:2px solid transparent;background:conic-gradient(from 0deg,#00D97E,rgba(0,217,126,0),#00D97E) border-box;-webkit-mask:linear-gradient(#fff 0 0) padding-box,linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude;animation:rs 6s linear infinite}
.kai-ring2{position:absolute;inset:-22px;border-radius:50%;border:1px solid rgba(0,217,126,.15);animation:rs 10s linear infinite reverse}
@keyframes rs{to{transform:rotate(360deg)}}
.kai-bubble{position:absolute;z-index:3;background:rgba(10,25,15,.92);border:1px solid rgba(0,217,126,.3);border-radius:12px;padding:10px 14px;font-size:12px;max-width:170px;backdrop-filter:blur(10px);animation:bi .5s ease both}
.kai-bubble.left{left:24px;top:50%;transform:translateY(-50%)}
.kai-bubble.right{right:24px;top:50%;transform:translateY(-50%);animation-delay:.3s}
@keyframes bi{from{opacity:0;transform:translateY(-40%) scale(.8)}to{opacity:1;transform:translateY(-50%) scale(1)}}
.kb-icon{font-size:18px;margin-bottom:4px}
.kb-t{font-size:10px;font-weight:700;color:var(--g);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px}
.kb-b{font-size:11px;color:var(--text2);line-height:1.5}
.kai-nametag{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);z-index:3;background:linear-gradient(135deg,rgba(0,217,126,.9),rgba(0,184,101,.9));color:#000;font-family:var(--font-h);font-size:13px;font-weight:800;padding:7px 22px;border-radius:100px;letter-spacing:.04em;white-space:nowrap;box-shadow:0 4px 20px rgba(0,217,126,.4)}
/* PHONE */
.phone-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);overflow:hidden}
.ph-hdr{background:linear-gradient(135deg,#075e54,#128c7e);padding:13px 16px;display:flex;align-items:center;gap:10px}
.ph-av{width:36px;height:36px;border-radius:50%;overflow:hidden;flex-shrink:0;border:2px solid rgba(255,255,255,.3)}
.ph-av img{width:100%;height:100%;object-fit:cover;object-position:top center}
.ph-name{font-size:14px;font-weight:600;color:#fff}
.ph-status{font-size:11px;color:rgba(255,255,255,.65)}
.ph-live{margin-left:auto;background:rgba(255,255,255,.15);padding:3px 10px;border-radius:4px;font-size:10px;font-weight:600;color:#fff}
.phone-msgs{background:#e5ddd5;min-height:290px;max-height:360px;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:7px}
.pmsg{max-width:78%;padding:9px 13px;border-radius:8px;font-size:13px;line-height:1.5;animation:mi .22s ease}
@keyframes mi{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.pmsg.bot{background:#fff;align-self:flex-start;border-radius:2px 10px 10px 10px;color:#1a1a1a;box-shadow:0 1px 2px rgba(0,0,0,.1)}
.pmsg.user{background:#dcf8c6;align-self:flex-end;border-radius:10px 10px 2px 10px;color:#1a1a1a}
.pmsg-time{font-size:10px;color:rgba(0,0,0,.35);text-align:right;margin-top:4px}
.ph-typing{display:flex;align-items:center;gap:4px;padding:9px 13px;background:#fff;border-radius:2px 10px 10px 10px;align-self:flex-start;width:55px}
.ptd{width:7px;height:7px;border-radius:50%;background:#aaa;animation:pta 1.2s ease infinite}
.ptd:nth-child(2){animation-delay:.2s}.ptd:nth-child(3){animation-delay:.4s}
@keyframes pta{0%,80%,100%{transform:scale(.5);opacity:.3}40%{transform:scale(1.2);opacity:1}}
.phone-input{background:#f0f0f0;padding:10px;display:flex;gap:8px;align-items:center}
.phone-input input{flex:1;background:#fff;border:none;border-radius:22px;padding:9px 16px;font-size:13px;outline:none;font-family:var(--font)}
.phone-send{background:#075e54;color:#fff;border:none;border-radius:50%;width:38px;height:38px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.phone-send:hover{background:#128c7e}
/* ROLES */
.roles-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px}
.role-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:22px;position:relative;overflow:hidden;transition:border-color .2s,transform .2s}
.role-card:hover{transform:translateY(-3px)}
.role-card::after{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.role-card.admin{border-color:rgba(168,85,247,.3)}.role-card.admin::after{background:var(--purple)}
.role-card.vendedor{border-color:rgba(75,158,255,.3)}.role-card.vendedor::after{background:var(--blue)}
.role-card.viewer{border-color:rgba(245,166,35,.3)}.role-card.viewer::after{background:var(--amber)}
.role-icon{font-size:28px;margin-bottom:10px}
.role-name{font-family:var(--font-h);font-size:16px;font-weight:800;margin-bottom:4px}
.role-desc{font-size:12px;color:var(--text2);margin-bottom:14px;line-height:1.5}
.perm-list{list-style:none}
.perm-list li{font-size:12px;color:var(--text2);padding:3px 0;display:flex;align-items:center;gap:7px}
.perm-list li::before{content:'✓';color:var(--g);font-weight:700;flex-shrink:0}
.perm-list li.no::before{content:'✗';color:rgba(255,75,75,.5)}.perm-list li.no{color:var(--text3)}
/* COMISIONES */
.plazos-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px}
.plazo-card{background:var(--bg3);border-radius:var(--r2);padding:16px;text-align:center;border:1px solid var(--border);transition:all .2s}
.plazo-card:hover{border-color:var(--border2);transform:translateY(-2px)}
.p-meses{font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.07em;margin-bottom:8px}
.p-pct{font-family:var(--font-h);font-size:32px;font-weight:800;line-height:1;margin-bottom:4px}
.p-base{font-size:12px;color:var(--text2);margin-bottom:6px}
.p-ej{font-size:11px;color:var(--text3)}
/* CAMPAÑAS */
.camp-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:16px;margin-bottom:16px}
.seg-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
.seg-tag{background:var(--g3);border:1px solid var(--border2);color:var(--g);font-size:11px;font-weight:600;padding:4px 10px;border-radius:100px;cursor:pointer;transition:all .15s}
.seg-tag:hover,.seg-tag.on{background:var(--g);color:#000}
.wa-prev{background:#0d1418;border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,.08)}
.wa-prev-hdr{background:#1a2a25;padding:12px 16px;display:flex;align-items:center;gap:10px;border-bottom:1px solid rgba(255,255,255,.06)}
.wa-prev-body{padding:14px;min-height:180px}
.wa-msg-p{background:#1e2e25;border-radius:4px 12px 12px 12px;padding:12px 14px;max-width:85%;font-size:12px;color:rgba(255,255,255,.85);line-height:1.6}
/* LOGIN */
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);position:relative;z-index:10;padding:20px}
.login-card{background:var(--bg2);border:1px solid var(--border2);border-radius:20px;padding:40px;width:100%;max-width:380px;position:relative;overflow:hidden}
.login-card::before{content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(0,217,126,.08) 0%,transparent 70%);pointer-events:none}
.login-logo{font-family:var(--font-h);font-size:30px;font-weight:800;color:var(--g);letter-spacing:-1.5px;margin-bottom:6px}
.login-sub{font-size:14px;color:var(--text2);margin-bottom:24px}
.login-btn{width:100%;background:linear-gradient(135deg,var(--g2),var(--g));color:#000;font-weight:700;font-size:14px;font-family:var(--font-h);border:none;border-radius:8px;padding:13px;cursor:pointer;letter-spacing:.02em;transition:opacity .2s;margin-top:8px}
.login-btn:hover{opacity:.88}
.login-err{color:var(--red);font-size:12px;margin-top:10px;display:none}
.page{display:none}.page.active{display:block;animation:fi .22s ease}
@keyframes fi{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.toast{position:fixed;bottom:24px;right:24px;background:var(--bg2);border:1px solid var(--border2);border-radius:10px;padding:12px 18px;font-size:13px;color:var(--text);z-index:9999;transform:translateY(100px);opacity:0;transition:all .3s;box-shadow:0 8px 32px rgba(0,0,0,.5)}
.toast.show{transform:translateY(0);opacity:1}
.toast.ok{border-color:rgba(0,217,126,.5);color:var(--g)}
.toast.err{border-color:rgba(255,75,75,.5);color:var(--red)}
@media(max-width:900px){.sb{transform:translateX(-100%)}.main{margin-left:0;padding:16px}
.mrow,.mrow3,.roles-grid,.plazos-grid,.camp-grid,.frow{grid-template-columns:1fr}}
</style>
</head>
<body>

<div id="login-wrap" class="login-wrap">
  <div class="login-card">
    <div class="login-logo">botly</div>
    <div class="login-sub">Selecciona tu rol para la demo</div>
    <div class="fg"><label class="fl">Correo</label><input class="fi" id="l-email" type="email" placeholder="colegio@botly.io"/></div>
    <div class="fg"><label class="fl">Contraseña</label><input class="fi" id="l-pass" type="password" placeholder="••••••••"/></div>
    <div class="fg" style="text-align:center;padding:8px 0">
      <div style="font-size:11px;color:var(--text3)">Tu rol se asigna automáticamente según tu cuenta</div>
    </div>
    <button class="login-btn" onclick="doLogin()">Ingresar →</button>
    <div id="l-err" class="login-err"></div>
  </div>
</div>

<div id="app" class="app" style="display:none">
  <aside class="sb">
    <div class="logo"><div class="logo-pulse"></div>botly</div>
    <div id="plan-tag" class="plan-tag">Plan Profesional</div>
    <div id="role-badge" class="role-badge ra">👑 Administrador</div>

    <div class="ns">Principal</div>
    <a class="nl active" onclick="nav('dashboard',this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>Dashboard
    </a>
    <a class="nl" onclick="nav('kai',this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a4 4 0 014-4h4a4 4 0 014 4v2"/></svg>Kai — Agente IA
    </a>
    <a class="nl" onclick="nav('leads',this)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>Leads / Alumnos
