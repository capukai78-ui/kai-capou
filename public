  if(page==='citas')renderCitas();
  if(page==='comisiones'){calcCom();renderVentas();}
  if(page==='campanas')prevMsg();
  if(page==='usuarios'){loadUsuarios();loadSedes();}
  if(page==='faqs')loadFaqs();
  if(page==='docs')loadDocs();
}

