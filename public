  const cls={admin:'ra',vendedor:'rv',viewer:'rg'};
  rb.textContent=nm[role]||nm.admin;
  rb.className='role-badge '+(cls[role]||'ra');

  // Reset all nav items visible first
  ['nav-campanas','nav-roles','ns-admin','nav-usuarios'].forEach(id=>{
    const el=document.getElementById(id);if(el)el.style.display='';
  });

  if(role==='vendedor'){
    // Vendedor: oculta Campañas, Roles y Config
    ['nav-campanas','nav-roles','ns-admin','nav-usuarios'].forEach(id=>{
      const el=document.getElementById(id);if(el)el.style.display='none';
    });
    const ds=document.getElementById('dash-sub');if(ds)ds.textContent='Vista Vendedor · Mis métricas';
    // Ocultar FAQs y Documentos en sidebar si existen
    ['nav-faqs','nav-docs'].forEach(id=>{const el=document.getElementById(id);if(el)el.style.display='none';});
  } else if(role==='viewer'){
    // Viewer/Gerente: oculta Campañas, Roles y Config — solo lectura
    ['nav-campanas','nav-roles','ns-admin','nav-faqs','nav-docs'].forEach(id=>{
      const el=document.getElementById(id);if(el)el.style.display='none';
    });
    const ds=document.getElementById('dash-sub');if(ds)ds.textContent='Vista Gerente · Solo lectura';
    // Deshabilitar selects de cambio de estado en leads
    document.querySelectorAll('select[onchange*="LEADS"]').forEach(s=>s.disabled=true);
  }
  // Admin: ve todo, sin restricciones

  const av=document.getElementById('u-av');if(av)av.textContent=(USER.nombre||'?')[0].toUpperCase();
  const un=document.getElementById('u-name');if(un)un.textContent=USER.nombre||'Demo';
  const ue=document.getElementById('u-email');if(ue)ue.textContent=USER.email||role+'@botly.io';
}

function nav(page,el){
