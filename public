async function saveUser(){
  const id=document.getElementById('edit-user-id').value;
  const nombre=document.getElementById('u-nombre').value.trim();
  const email=document.getElementById('u-email-new').value.trim();
  const pass=document.getElementById('u-pass').value;
  const role=document.getElementById('u-role').value;
  const sedes=[...document.querySelectorAll('.sede-chk:checked')].map(c=>c.value);
  const errEl=document.getElementById('user-modal-err');
  errEl.style.display='none';
  if(!nombre||!email){errEl.textContent='Nombre y correo son requeridos';errEl.style.display='block';return;}
  if(!id&&!pass){errEl.textContent='La contraseña es requerida para nuevos usuarios';errEl.style.display='block';return;}
  const body={nombre,role,sedes};
  if(!id)body.email=email;
  if(pass)body.password=pass;
  try{
    const url=id?`${API}/api/usuarios/${id}`:`${API}/api/usuarios`;
    const method=id?'PUT':'POST';
    if(!id)body.email=email;
    const r=await fetch(url,{method,headers:{'Content-Type':'application/json',Authorization:`Bearer ${TOKEN}`},body:JSON.stringify(body)});
    const d=await r.json();
    if(!d.ok){errEl.textContent=d.error||'Error al guardar';errEl.style.display='block';return;}
    closeModalUser();
    showToast(id?'Usuario actualizado ✓':'Usuario creado ✓','ok');
    loadUsuarios();
  }catch(e){errEl.textContent='Error de conexión';errEl.style.display='block';}
}

