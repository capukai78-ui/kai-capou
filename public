function sb(e){const m={nuevo:'<span class="bx blue">Nuevo</span>',contactado:'<span class="bx warn">Contactado</span>',visita_agendada:'<span class="bx purple">Visita agendada</span>',inscrito:'<span class="bx ok">Inscrito</span>',perdido:'<span class="bx red">Perdido</span>'};return m[e]||`<span class="bx">${e}</span>`;}

let citasData=[...CITAS];
function renderCitas(){
