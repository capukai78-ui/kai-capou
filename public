}

async function agendarCita(){
  const nombre=document.getElementById('oh-nombre').value.trim();
  const tel=document.getElementById('oh-tel').value.trim();
  const grado=document.getElementById('oh-grado').value;
  const sede=document.getElementById('oh-sede').value;
  const fecha=document.getElementById('oh-fecha').value;
  const hora=document.getElementById('oh-hora').value;
  if(!nombre||!tel||!fecha){showToast('Completa nombre, teléfono y fecha','err');return;}
  if(citasData.filter(c=>c.fecha===fecha&&c.hora===hora).length>=10){showToast('Horario lleno. Elige otra hora.','err');return;}
  citasData.push({nombre,tel,grado,sede,fecha,hora,estado:'confirmada'});
  renderCitas();
  document.getElementById('modal-cita').style.display='none';
  document.getElementById('oh-nombre').value='';
