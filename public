    <div style="background:var(--bg3);border:1px solid var(--border);border-radius:var(--r2);padding:14px;text-align:center"><div style="font-size:11px;color:var(--text2);margin-bottom:6px">MARGEN BOTLY</div><div style="font-family:var(--font-h);font-size:24px;font-weight:800;color:var(--blue)">Q${(total-com).toLocaleString()}</div><div style="font-size:11px;color:var(--text3);margin-top:4px">${Math.round((1-pct)*100)}% del contrato</div></div>`;
