async function doLogin(){
  const email=document.getElementById('l-email').value.trim();
  const pass=document.getElementById('l-pass').value;
  const errEl=document.getElementById('l-err');
  errEl.style.display='none';
  if(!email||!pass){errEl.textContent='Ingresa correo y contraseña';errEl.style.display='block';return;}
  const btn=document.querySelector('.login-btn');
  btn.textContent='Ingresando...';btn.disabled=true;
  try{
    const r=await fetch(`${API}/api/login`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password:pass})});
    const d=await r.json();
    if(!d.ok){errEl.textContent=d.error||'Credenciales incorrectas';errEl.style.display='block';btn.textContent='Ingresar →';btn.disabled=false;return;}
    TOKEN=d.token;
    USER=d.user;
    ROLE=d.user.role;
    localStorage.setItem('botly_token',TOKEN);
    localStorage.setItem('botly_role',ROLE);
    localStorage.setItem('botly_user',JSON.stringify(USER));
    document.getElementById('login-wrap').style.display='none';
    document.getElementById('app').style.display='flex';
    applyRole(ROLE);
    initApp();
  }catch(e){
    errEl.textContent='Error de conexión. Intenta de nuevo.';
    errEl.style.display='block';
    btn.textContent='Ingresar →';btn.disabled=false;
  }
}
document.getElementById('l-pass')?.addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});
function doLogout(){localStorage.clear();window.location.reload();}

function applyRole(role){
  const rb=document.getElementById('role-badge');
