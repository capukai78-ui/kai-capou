async function handleImgSelect(event){
  const file=event.target.files[0];
  if(!file)return;
  const preview=document.getElementById('doc-preview');
  const nombreInput=document.getElementById('doc-nombre');
  if(!nombreInput.value) nombreInput.value=file.name.replace(/\.\w+$/,'');

  if(file.name.endsWith('.txt')){
    const reader=new FileReader();
    reader.onload=e=>{document.getElementById('doc-contenido').value=e.target.result;};
    reader.readAsText(file);
    preview.style.display='block';
    preview.innerHTML='✅ Texto cargado correctamente';
    preview.style.color='var(--green)';
    return;
  }

  if(file.type==='application/pdf'||file.name.endsWith('.pdf')||file.name.endsWith('.docx')||file.name.endsWith('.doc')){
    preview.style.display='block';
    preview.innerHTML='⏳ Extrayendo texto del documento...';
    preview.style.color='var(--text2)';
    document.getElementById('doc-contenido').value='';
    try{
      const formData=new FormData();
      formData.append('file',file);
      const r=await fetch(`${API}/api/documentos/extraer-texto`,{method:'POST',headers:{Authorization:`Bearer ${TOKEN}`},body:formData});
      const d=await r.json();
      if(d.ok&&d.texto){
        document.getElementById('doc-contenido').value=d.texto;
        preview.innerHTML=`✅ ${file.name} — ${d.paginas||''}pags, ${d.texto.length} caracteres extraídos`;
        preview.style.color='var(--green)';
      }else{
        preview.innerHTML='⚠️ No se pudo extraer texto automáticamente. Pega el contenido abajo.';
        preview.style.color='var(--warn)';
      }
    }catch(e){
      preview.innerHTML='⚠️ Error al procesar. Pega el texto abajo.';
      preview.style.color='var(--warn)';
    }
    return;
  }

  preview.style.display='block';
  preview.innerHTML='📄 Archivo seleccionado — pega el texto en el área de abajo';
}
function handleDocDrop(event){
